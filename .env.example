# ---- Database ----
# Dev default is SQLite (zero-config). For production, switch prisma/schema.prisma
# provider to "postgresql" and set a Postgres URL here.
DATABASE_URL="file:./dev.db"

# ---- Auth (NextAuth / Auth.js) ----
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google SSO (optional in dev — a "demo login" is available without these).
# Restrict to your workspace domain in production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAIL_DOMAIN="must.company"

# Set to "true" to enable the demo (no-Google) sign-in buttons. Turn OFF in production.
ENABLE_DEMO_LOGIN="true"
